# Python bytecode — generated by running color_check.py and its tests.
__pycache__/
*.py[cod]

# Never commit business identifiers (W2/W3). The file may not exist
# in every clone; the ignore protects the day it lands.
config/identity.json

# gate_run.py write surfaces — machine-generated, never committed.
gate_receipts.jsonl
reports/
vault_lint_baseline.json
vault_repair_receipts.jsonl

# vault_backup's REAL config carries Khai's local paths — only the
# committed .example file travels. (Its write surfaces — manifest,
# receipts, staging, trash — live in the destination dir, never here.)
vault_backup.config.json

# asset_ingest: real config is local paths; receipts are a
# machine-generated write surface. CF assets themselves land under
# the configured assets_dir and are NEVER committed (W10).
asset_ingest.config.json
asset_ingest_receipts.jsonl

# play_forge: real config is local paths; receipts are a write
# surface. Renders/fonts/assets live under configured vault-side
# dirs and are NEVER committed (B2 W11).
play_forge.config.json
play_forge_receipts.jsonl
